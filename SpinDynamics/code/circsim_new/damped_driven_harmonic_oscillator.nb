 CellChangeTimes->{{3.5732310893211603`*^9, 3.5732310983500633`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"soln", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "+", " ", 
         RowBox[{
          RowBox[{"y", "[", "t", "]"}], "/", "\[Tau]"}]}], "==", 
        RowBox[{
         RowBox[{"UnitStep", "[", "t", "]"}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Omega]", " ", "t"}], "+", "\[Phi]"}], ")"}]}]]}]}], 
       ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ic", "[", "t_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "/.", 
    RowBox[{"soln", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ictab", "[", "t_", "]"}], "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ic", "[", "t", "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Tau]", "\[Rule]", 
         RowBox[{"0.1", "j"}]}], ",", 
        RowBox[{"\[Omega]", "\[Rule]", "1.1"}], ",", 
        RowBox[{"\[Phi]", "\[Rule]", "0"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "9"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"Ictab", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"Ictab", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "50"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"y", "[", "t", "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.573231123599588*^9, 3.5732312046236897`*^9}, {
  3.5734885143285775`*^9, 3.5734885193355775`*^9}, {3.573488587035578*^9, 
  3.573488595219578*^9}, {3.5734890994643745`*^9, 3.5734891041288404`*^9}, {
  3.573489392332658*^9, 3.5734893928687115`*^9}, {3.598356192535595*^9, 
  3.5983561962465954`*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["t", "\[Tau]"]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"t", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "\[Tau]"], "+", 
            RowBox[{"\[ImaginaryI]", " ", "\[Omega]"}]}], ")"}]}]]}], ")"}], 
      " ", "\[Tau]", " ", 
      RowBox[{"UnitStep", "[", "t", "]"}]}], 
     RowBox[{"1", "+", 
      RowBox[{"\[ImaginaryI]", " ", "\[Tau]", " ", "\[Omega]"}]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.5732312062178493`*^9, 3.5734885239865775`*^9, 
  3.5734885988075776`*^9, 3.5734891071211395`*^9}],

