        RowBox[{"(", 
         RowBox[{"gamma", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["gamma", "2"], "-", 
            SuperscriptBox["wn", "2"]}]]}], ")"}]}]}]], " ", 
