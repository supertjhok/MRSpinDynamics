Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"exponential", " ", "input"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"soln", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "''"}], "[", "tv", "]"}], "+", 
           RowBox[{"2", " ", "gamma", " ", 
            RowBox[{
             RowBox[{"y", "'"}], "[", "tv", "]"}]}], "+", 
           RowBox[{
            SuperscriptBox["wn", "2"], " ", 
            RowBox[{"y", "[", "tv", "]"}]}]}], "==", 
          RowBox[{
           RowBox[{"UnitStep", "[", "tv", "]"}], 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[ImaginaryI]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"w", " ", "tv"}], "+", "phi"}], ")"}]}]]}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
       RowBox[{"y", "[", "tv", "]"}], ",", "tv"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ic", "[", "tv_", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"y", "[", "tv", "]"}], "/.", 
      RowBox[{"soln", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dIc", "[", "tv_", "]"}], " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Ic", "[", "tv", "]"}], ",", "tv"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ictab", "[", "tv_", "]"}], "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Ic", "[", "tv", "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"gamma", "\[Rule]", 
           RowBox[{"0.1", "j"}]}], ",", 
          RowBox[{"wn", "\[Rule]", "1"}], ",", 
          RowBox[{"w", "\[Rule]", "1.1"}], ",", 
          RowBox[{"phi", "\[Rule]", "0"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "9"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dIctab", "[", "tv_", "]"}], "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dIc", "[", "tv", "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"gamma", "\[Rule]", 
           RowBox[{"0.1", "j"}]}], ",", 
          RowBox[{"wn", "\[Rule]", "1"}], ",", 
          RowBox[{"w", "\[Rule]", "1.1"}], ",", 
          RowBox[{"phi", "\[Rule]", "0"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "9"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Ictab", "[", "tv", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"Ictab", "[", "tv", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tv", ",", 
       RowBox[{"-", "1"}], ",", "50"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"dIctab", "[", "tv", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"dIctab", "[", "tv", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tv", ",", 
       RowBox[{"-", "1"}], ",", "50"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.5726378891928773`*^9, 3.5726379142398777`*^9}, {
  3.5726379624998775`*^9, 3.572637963747877*^9}, {3.5726380029258776`*^9, 
  3.5726380381178775`*^9}, {3.5726380771838775`*^9, 3.5726380796728773`*^9}, {
  3.5728925996897926`*^9, 3.572892609982822*^9}, {3.5983561776295953`*^9, 
  3.5983561860625954`*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "tv", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "phi"}], "-", 
         RowBox[{"tv", " ", 
          RowBox[{"(", 
           RowBox[{"gamma", "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"gamma", "-", "wn"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{"gamma", "+", "wn"}], ")"}]}]]}], ")"}]}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"2", " ", "tv", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["gamma", "2"], "-", 
                SuperscriptBox["wn", "2"]}]]}]]}], ")"}], " ", "gamma"}], "+", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"2", " ", "tv", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["gamma", "2"], "-", 
                SuperscriptBox["wn", "2"]}]]}]]}], ")"}], " ", "w"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"2", " ", "tv", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["gamma", "2"], "-", 
                SuperscriptBox["wn", "2"]}]]}]], "-", 
            RowBox[{"2", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"tv", " ", 
               RowBox[{"(", 
                RowBox[{"gamma", "+", 
                 RowBox[{"\[ImaginaryI]", " ", "w"}], "+", 
                 SqrtBox[
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"gamma", "-", "wn"}], ")"}], " ", 
                   RowBox[{"(", 
                    RowBox[{"gamma", "+", "wn"}], ")"}]}]]}], ")"}]}]]}]}], 
           ")"}], " ", 
