  "]"}]], "Input",
 CellChangeTimes->{{3.5726381720218773`*^9, 3.572638184412877*^9}}],

Cell["\<\
(E^(I*phi - tv*(gamma + Sqrt[gamma^2 - wn^2]))*((-1 + E^(2*tv*Sqrt[gamma^2 - \
wn^2]))*gamma*w - I*(-1 + E^(2*tv*Sqrt[gamma^2 - wn^2]))*wn^2 - (1 + \
E^(2*tv*Sqrt[gamma^2 - wn^2]) - 2*E^(tv*(gamma + I*w + Sqrt[gamma^2 - \
wn^2])))*w*Sqrt[gamma^2 - wn^2]))/
 (2*Sqrt[(gamma - wn)*(gamma + wn)]*(2*gamma*w + I*(w - wn)*(w + wn)))\
\>", "Output",
 CellChangeTimes->{3.5726381870338774`*^9}]
}, Open  ]],

