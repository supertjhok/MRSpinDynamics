Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InputForm", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "phi"}], "-", 
       RowBox[{"tv", " ", 
        RowBox[{"(", 
         RowBox[{"gamma", "+", 
          SqrtBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"gamma", "-", "wn"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"gamma", "+", "wn"}], ")"}]}]]}], ")"}]}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "tv", " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["gamma", "2"], "-", 
              SuperscriptBox["wn", "2"]}]]}]]}], ")"}], " ", "gamma"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "tv", " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["gamma", "2"], "-", 
              SuperscriptBox["wn", "2"]}]]}]]}], ")"}], " ", "w"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "tv", " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["gamma", "2"], "-", 
              SuperscriptBox["wn", "2"]}]]}]], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"tv", " ", 
             RowBox[{"(", 
              RowBox[{"gamma", "+", 
               RowBox[{"\[ImaginaryI]", " ", "w"}], "+", 
               SqrtBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"gamma", "-", "wn"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"gamma", "+", "wn"}], ")"}]}]]}], ")"}]}]]}]}], 
         ")"}], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"gamma", "-", "wn"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"gamma", "+", "wn"}], ")"}]}]]}]}], ")"}], " ", 
     RowBox[{"UnitStep", "[", "tv", "]"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"gamma", "-", "wn"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"gamma", "+", "wn"}], ")"}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "gamma", " ", "w"}], 
       "+", 
       SuperscriptBox["w", "2"], "-", 
       SuperscriptBox["wn", "2"]}], ")"}]}], ")"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.5726381509738774`*^9, 3.5726381645618773`*^9}}],

Cell["\<\
(E^(I*phi - tv*(gamma + Sqrt[(gamma - wn)*(gamma + wn)]))*((-1 + \
E^(2*tv*Sqrt[gamma^2 - wn^2]))*gamma + I*(-1 + E^(2*tv*Sqrt[gamma^2 - \
wn^2]))*w + (1 + E^(2*tv*Sqrt[gamma^2 - wn^2]) - 2*E^(tv*(gamma + I*w + \
Sqrt[(gamma - wn)*(gamma + wn)])))*
    Sqrt[(gamma - wn)*(gamma + wn)])*UnitStep[tv])/(2*Sqrt[(gamma - \
wn)*(gamma + wn)]*((-2*I)*gamma*w + w^2 - wn^2))\
\>", "Output",
 CellChangeTimes->{3.5726381661928773`*^9}]
}, Open  ]],

