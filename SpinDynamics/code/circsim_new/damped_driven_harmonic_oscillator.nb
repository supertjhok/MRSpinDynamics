        SuperscriptBox["wn", "2"]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "tv", " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["gamma", "2"], "-", 
              SuperscriptBox["wn", "2"]}]]}]], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"tv", " ", 
