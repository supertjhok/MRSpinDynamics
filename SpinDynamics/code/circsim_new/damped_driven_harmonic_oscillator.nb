Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"soln", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "+", " ", 
         RowBox[{
          RowBox[{"y", "[", "t", "]"}], "/", "\[Tau]"}]}], "==", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
          RowBox[{"t", "-", "T"}], "]"}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Omega]", " ", "t"}], "+", "\[Phi]"}], ")"}]}]]}]}], 
       ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ic", "[", "t_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "/.", 
    RowBox[{"soln", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ictab", "[", "t_", "]"}], "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ic", "[", "t", "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Tau]", "\[Rule]", 
         RowBox[{"0.1", "j"}]}], ",", 
        RowBox[{"\[Omega]", "\[Rule]", "1.1"}], ",", 
        RowBox[{"\[Phi]", "\[Rule]", "0"}], ",", 
        RowBox[{"T", "\[Rule]", "1"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "9"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"Ictab", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"Ictab", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "50"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"y", "[", "t", "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5734893839638214`*^9, 3.5734893842738523`*^9}, {
  3.598356200900595*^9, 3.598356207615595*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["t", "\[Tau]"]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]], " ", "\[Tau]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"t", " ", 
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "\[Tau]"], "+", 
              RowBox[{"\[ImaginaryI]", " ", "\[Omega]"}]}], ")"}]}]]}], " ", 
         RowBox[{"UnitStep", "[", 
          RowBox[{"t", "-", "T"}], "]"}]}], "+", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"T", " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "\[Tau]"], "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Omega]"}]}], ")"}]}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"UnitStep", "[", 
            RowBox[{"t", "-", "T"}], "]"}], "-", 
           RowBox[{"UnitStep", "[", 
            RowBox[{"-", "T"}], "]"}]}], ")"}]}], "+", 
        RowBox[{"UnitStep", "[", 
         RowBox[{"-", "T"}], "]"}]}], ")"}]}], 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "+", 
      RowBox[{"\[Tau]", " ", "\[Omega]"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.5734893975371785`*^9}],

