{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrspindynamics.local/nqr-mail-screening/materials.schema.json",
  "title": "14N NQR mail-screening development material library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "library_version",
    "study_id",
    "status",
    "source_database",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "library_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "study_id": {
      "const": "nqr-mail-screening"
    },
    "status": {
      "enum": [
        "development",
        "frozen",
        "retired"
      ]
    },
    "source_database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "repository_commit"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/material"
      }
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "isotope",
        "database_compound_id",
        "physical_test_status",
        "candidate_lines",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^material\\.[a-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "target",
            "benign_confuser",
            "null"
          ]
        },
        "isotope": {
          "enum": [
            "14N",
            null
          ]
        },
        "database_compound_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical_test_status": {
          "enum": [
            "simulation_only",
            "candidate_pending_safety_review",
            "approved"
          ]
        },
        "candidate_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "notes": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "site_id",
        "frequency_hz",
        "fwhm_hz",
        "t1_s",
        "t2_s",
        "t2_star_s",
        "dnu_dt_hz_per_k",
        "reference_temperature_k",
        "evidence_class"
      ],
      "properties": {
        "line_id": {
          "type": "string"
        },
        "site_id": {
          "type": "string"
        },
        "frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fwhm_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "t1_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "t2_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "t2_star_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "dnu_dt_hz_per_k": {
          "type": [
            "number",
            "null"
          ]
        },
        "reference_temperature_k": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "evidence_class": {
          "const": "literature"
        }
      }
    }
  }
}
