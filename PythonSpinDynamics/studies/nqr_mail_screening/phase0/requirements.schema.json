{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrspindynamics.local/nqr-mail-screening/requirements.schema.json",
  "title": "14N NQR mail-screening requirements worksheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements_version",
    "study_id",
    "status",
    "reference_concept",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "requirements_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "study_id": {
      "const": "nqr-mail-screening"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired",
        "study_ready"
      ]
    },
    "reference_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isotope",
        "operating_mode",
        "detector_baseline",
        "status"
      ],
      "properties": {
        "isotope": {
          "const": "14N"
        },
        "operating_mode": {
          "type": "string"
        },
        "detector_baseline": {
          "type": "string"
        },
        "status": {
          "enum": [
            "provisional",
            "approved"
          ]
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value_type",
        "value",
        "units",
        "status",
        "blocking_gate_0",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^req\\.[a-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "number",
            "probability",
            "string",
            "vector3",
            "range",
            "list"
          ]
        },
        "value": {
          "type": [
            "null",
            "number",
            "string",
            "array"
          ]
        },
        "units": {
          "type": [
            "null",
            "string"
          ]
        },
        "status": {
          "enum": [
            "unresolved",
            "provisional",
            "approved",
            "not_applicable"
          ]
        },
        "blocking_gate_0": {
          "type": "boolean"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "evidence_class",
            "reference",
            "notes"
          ],
          "properties": {
            "owner": {
              "type": [
                "null",
                "string"
              ]
            },
            "evidence_class": {
              "enum": [
                null,
                "predicted",
                "literature",
                "measured_calibration",
                "fitted",
                "held_out_validation"
              ]
            },
            "reference": {
              "type": [
                "null",
                "string"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
