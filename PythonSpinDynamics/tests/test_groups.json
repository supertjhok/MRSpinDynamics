{
  "always": [
    "tests.smoke_tests"
  ],
  "groups": {
    "nqr": {
      "paths": [
        "src/spin_dynamics/nqr/**",
        "src/spin_dynamics/optimal_control/_jax_propagation.py",
        "src/spin_dynamics/optimal_control/multi_axis.py",
        "tests/test_nqr*.py",
        "tests/test_optimal_control_multi_axis.py",
        "tests/test_batched_nqr.py",
        "examples/*nqr*.py"
      ],
      "tests": [
        "tests.test_nqr_crossover",
        "tests.test_nqr",
        "tests.test_nqr_full_dynamics",
        "tests.test_nqr_higher_spin",
        "tests.test_nqr_model_selection",
        "tests.test_nqr_multi_axis",
        "tests.test_batched_nqr",
        "tests.test_nqr_lab_frame",
        "tests.test_nqr_rwa_validation",
        "tests.test_nqr_floquet",
        "tests.test_nqr_field_relaxation",
        "tests.test_optimal_control_multi_axis"
      ]
    },
    "nano_mr": {
      "paths": [
        "src/spin_dynamics/nano_mr/**",
        "src/spin_dynamics/experiment/nano_mr_adapter.py",
        "tests/test_nano_mr.py",
        "tests/test_nano_mr_experiment.py",
        "examples/*nano_mr*.py",
        "examples/*esr_nano_mr*.py",
        "docs/nano_mr_plan.md",
        "docs/python_api/nano_mr.md"
      ],
      "tests": [
        "tests.test_nano_mr",
        "tests.test_nano_mr_experiment"
      ]
    },
    "relaxation": {
      "paths": [
        "src/spin_dynamics/relaxation.py",
        "src/spin_dynamics/nqr/relaxation.py",
        "tests/test_*relaxation*.py"
      ],
      "tests": [
        "tests.test_relaxation",
        "tests.test_relaxation_workflows",
        "tests.test_relaxation_validation",
        "tests.test_nqr_redfield_relaxation"
      ]
    },
    "experiment": {
      "paths": [
        "src/spin_dynamics/experiment/**",
        "tests/test_experiment*.py"
      ],
      "tests": [
        "tests.test_experiment",
        "tests.test_experiment_cli"
      ]
    },
    "design": {
      "paths": [
        "src/spin_dynamics/design/**",
        "tests/test_bayesian_design*.py",
        "examples/*bayesian*"
      ],
      "tests": [
        "tests.test_bayesian_design",
        "tests.test_bayesian_design_core"
      ]
    }
  }
}
